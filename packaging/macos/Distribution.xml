<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Tipp10</title>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <license file="License.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" supportedArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <volume-check>
        <allowed-os-versions><os-version min="26.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline><line choice="tipp10"/></choices-outline>
    <choice id="tipp10" title="Tipp10" visible="false">
        <pkg-ref id="org.tipp10.tipp10.installer"/>
    </choice>
    <pkg-ref id="org.tipp10.tipp10.installer" version="2026.10.2">Tipp10-component.pkg</pkg-ref>
</installer-gui-script>
